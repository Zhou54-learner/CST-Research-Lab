        {
            "caption": "use template: Dispersion Diagram - Unit Cell - Rectangular Lattice (90 degree)_7.cfg",
            "version": "2025.1|34.0.1|20241028",
            "hidden": false,
            "type": "vba",
            "code": [
                "'set the units",
                "With Units",
                "    .SetUnit \"Length\", \"um\"",
                "    .SetUnit \"Frequency\", \"GHz\"",
                "    .SetUnit \"Voltage\", \"V\"",
                "    .SetUnit \"Resistance\", \"Ohm\"",
                "    .SetUnit \"Inductance\", \"nH\"",
                "    .SetUnit \"Temperature\",  \"degC\"",
                "    .SetUnit \"Time\", \"ns\"",
                "    .SetUnit \"Current\", \"A\"",
                "    .SetUnit \"Conductance\", \"S\"",
                "    .SetUnit \"Capacitance\", \"pF\"",
                "End With",
                "",
                "ThermalSolver.AmbientTemperature \"0\"",
                "",
                "'----------------------------------------------------------------------------",
                "",
                "Plot.DrawBox True",
                "",
                "With Background",
                "     .Type \"Normal\"",
                "     .Epsilon \"1.0\"",
                "     .Mu \"1.0\"",
                "     .Rho \"1.204\"",
                "     .ThermalType \"Normal\"",
                "     .ThermalConductivity \"0.026\"",
                "      .SpecificHeat \"1005\", \"J/K/kg\"",
                "     .XminSpace \"0.0\"",
                "     .XmaxSpace \"0.0\"",
                "     .YminSpace \"0.0\"",
                "     .YmaxSpace \"0.0\"",
                "     .ZminSpace \"0.0\"",
                "     .ZmaxSpace \"0.0\"",
                "End With",
                "",
                "MakeSureParameterExists \"PathPara\", \"1\"",
                "SetParameterDescription \"PathPara\", \"Master Parameter, sweeping from 0.1 to 2.9 will cover whole Brillouin zone\"",
                "MakeSureParameterExists \"phaseX\", \"Choose(Fix(PathPara)+1, PathPara*180, 180, 180-(PathPara-2)*180)\"",
                "SetParameterDescription \"phaseX\", \"phase difference between periodic x-boundaries\"",
                "MakeSureParameterExists \"phaseY\", \"Choose(Fix(PathPara)+1, 0, (PathPara-1)*180, 180-(PathPara-2)*180)\"",
                "SetParameterDescription \"phaseY\", \"phase difference between periodic y-boundaries\"",
                "",
                "' define periodic boundaries",
                "",
                "With Boundary",
                "     .Xmin \"periodic\"",
                "     .Xmax \"periodic\"",
                "     .Ymin \"periodic\"",
                "     .Ymax \"periodic\"",
                "     .Zmin \"electric\"",
                "     .Zmax \"electric\"",
                "     .Xsymmetry \"none\"",
                "     .Ysymmetry \"none\"",
                "     .Zsymmetry \"none\"",
                "     .ApplyInAllDirections \"False\"",
                "     .XPeriodicShift \"phaseX\"",
                "     .YPeriodicShift \"phaseY\"",
                "     .ZPeriodicShift \"0.0\"",
                "     .PeriodicUseConstantAngles \"False\"",
                "End With",
                "",
                "With ParameterSweep",
                "     .AddSequence \"Sequence 1\"",
                "     .AddParameter_Samples \"Sequence 1\", \"PathPara\", \"0.1\", \"2.9\", \"11\", \"False\"",
                "End With",
                "",
                "'----------------------------------------------------------------------------",
                "",
                "With MeshSettings",
                "     .SetMeshType \"Tet\"",
                "     .Set \"Version\", 1%",
                "End With",
                "",
                "With Mesh",
                "     .MeshType \"Tetrahedral\"",
                "End With",
                "",
                "'set the solver type",
                "ChangeSolverType(\"HF Eigenmode\")",
                "",
                "'----------------------------------------------------------------------------"
            ]
        },
